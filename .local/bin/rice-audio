#!/usr/bin/env bash
# Waybar right click: show/hide the TUI app "audio" (~/.local/share/rice-apps/ricetui.py).
# The process runs permanently in the background (start from hyprland.lua), a click only writes
# the name into its pipe – so the window appears instantly. Optional: rice-audio <tab|hide>.
# No pkill here (costs up to 100 ms) – the background process closes open menus itself.
fifo=$XDG_RUNTIME_DIR/rice-tui.fifo
read -r pid < "$XDG_RUNTIME_DIR/rice-tui.pid" 2>/dev/null
if [[ -n $pid && -p $fifo ]] && kill -0 "$pid" 2>/dev/null; then
    echo "audio${1:+:$1}" > "$fifo"
else
    setsid -f python3 "$HOME/.local/share/rice-apps/ricetui.py" --show="audio${1:+:$1}" >/dev/null 2>&1
fi

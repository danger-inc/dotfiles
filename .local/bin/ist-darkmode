#!/usr/bin/env bash
# Toggle light/dark for the whole suite (Super+Shift+W): scan-bar animation (settings: design choice of each app),
# otherwise all windows at the same moment ("at" in ~/.config/ist-theme.json).
exec python3 -c '
import sys, os
sys.path.insert(0, os.path.expanduser("~/.local/share/rice-apps"))
import istheme
m = "light" if istheme.load()["mode"] == "dark" else "dark"
istheme.switch(mode=m)
print(m)
'

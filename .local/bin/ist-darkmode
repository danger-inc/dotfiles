#!/usr/bin/env bash
# Hell/Dunkel der ganzen Suite umschalten (Super+Shift+W): Scanbalken-Animation (Einstellungen: Design-Auswahl jeder App),
# sonst alle Fenster im selben Moment ("at" in ~/.config/ist-theme.json).
exec python3 -c '
import sys, os
sys.path.insert(0, os.path.expanduser("~/.local/share/rice-apps"))
import istheme
m = "light" if istheme.load()["mode"] == "dark" else "dark"
istheme.switch(mode=m)
print(m)
'

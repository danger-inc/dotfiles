{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Called via "161" (~/.config/fastfetch/161.sh): picks the layout by window width.
  // Colors: blue = primary, cyan = secondary, magenta = tertiary (matugen via kitty).
  // Logo: make-logo.py, colors from the kitty palette 17-26 (kitty-colors.sh), recolor on Super+W.
  // Left margin (centering) comes from 161.sh.
  // Style: inspired by Evangelion title cards/NERV displays (capital letters, numbered sections).
  "logo": {
    // Finished ANSI file from make-logo.py (pixel art, colors from the kitty palette 17-26)
    "type": "file-raw",
    "source": "~/.config/fastfetch/161.txt",
    "padding": {
      "top": 1,
      "right": 4
    }
  },
  "display": {
    "separator": "",
    // cut off too-long lines instead of wrapping
    "disableLinewrap": true,
    "key": {
      "width": 14
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#magenta}SYSTEM {#38;5;23}━━━━━━━━━━━━━━━━━━━━━━━━ {#magenta}01"
    },
    { "type": "os",       "key": " 󰣇  OS",       "format": "{2}",            "keyColor": "blue" },
    { "type": "kernel",   "key": " 󰌽  KERNEL",   "format": "{2}",            "keyColor": "blue" },
    { "type": "packages", "key": " 󰏗  PAKETE",   "format": "{all}",          "keyColor": "blue" },
    { "type": "wm",       "key": " 󱗃  WM",       "format": "{2}",            "keyColor": "cyan" },
    { "type": "terminal", "key": " 󰆍  TERMINAL", "format": "{5}",            "keyColor": "cyan" },
    { "type": "display",  "key": " 󰍹  DISPLAY",  "format": "{1}x{2} @ {3}Hz", "keyColor": "cyan" },
    { "type": "break" },
    {
      "type": "custom",
      "format": "{#magenta}HARDWARE {#38;5;23}━━━━━━━━━━━━━━━━━━━━━━ {#magenta}02"
    },
    { "type": "cpu",      "key": " 󰻠  CPU",      "format": "{1}",            "keyColor": "blue" },
    { "type": "gpu",      "key": " 󰊴  GPU",      "format": "{1} Radeon Vega", "keyColor": "blue" },
    { "type": "memory",   "key": " 󰍛  RAM",      "format": "{1} / {2}",      "keyColor": "cyan" },
    { "type": "uptime",   "key": " 󱫐  UPTIME",                              "keyColor": "cyan" },
    { "type": "break" },
    { "type": "colors", "paddingLeft": 1, "symbol": "square" }
  ]
}

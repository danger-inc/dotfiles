/* Generated automatically by matugen from {{image}} */
/* Vorlage: ~/.config/matugen/templates/colors-rofi.rasi */
* {
    /* 99 = 60 % opacity like kitty, 4d = 30 % for the search field */
    bg:           #{{colors.surface.default.hex_stripped}}99;
    bg-input:     #{{colors.surface.default.hex_stripped}}4d;
    border-dim:   #{{colors.primary.default.hex_stripped}}73;
    bg-alt:       {{colors.surface_container_high.default.hex}};
    bg-selected:  {{colors.primary.default.hex}};
    fg:           {{colors.on_surface.default.hex}};
    fg-dim:       {{colors.outline.default.hex}};
    fg-selected:  {{colors.on_primary.default.hex}};
    border-color: {{colors.primary.default.hex}};
    /* -ist look (launcher): surface 85 %, tab 22 %, row 12 %, line 55 % */
    bg-panel:     #{{colors.surface.default.hex_stripped}}d9;
    bg-tab:       #{{colors.primary.default.hex_stripped}}38;
    bg-hover:     #{{colors.primary.default.hex_stripped}}1f;
    line:         #{{colors.primary.default.hex_stripped}}8c;
    fg-accent:    {{colors.primary.default.hex}};
}

# btop colors from the current wallpaper (matugen). Do not edit by hand,
# template: ~/.config/matugen/templates/btop.theme
theme[main_bg]="#121318"
theme[main_fg]="#e2e2e9"
theme[title]="#aec6ff"
theme[hi_fg]="#aec6ff"
theme[selected_bg]="#2c4678"
theme[selected_fg]="#d8e2ff"
theme[inactive_fg]="#8e9099"
theme[graph_text]="#c5c6d0"
theme[meter_bg]="#282a2f"
theme[proc_misc]="#bfc6dc"
theme[cpu_box]="#aec6ff"
theme[mem_box]="#bfc6dc"
theme[net_box]="#dfbbde"
theme[proc_box]="#aec6ff"
theme[div_line]="#44474f"
# gradients: calm -> accent -> warning color at high load
theme[temp_start]="#bfc6dc"
theme[temp_mid]="#aec6ff"
theme[temp_end]="#ffb4ab"
theme[cpu_start]="#bfc6dc"
theme[cpu_mid]="#aec6ff"
theme[cpu_end]="#ffb4ab"
theme[free_start]="#3f4759"
theme[free_mid]="#bfc6dc"
theme[free_end]="#dbe2f9"
theme[cached_start]="#583e5a"
theme[cached_mid]="#dfbbde"
theme[cached_end]="#fcd7fb"
theme[available_start]="#2c4678"
theme[available_mid]="#aec6ff"
theme[available_end]="#d8e2ff"
theme[used_start]="#aec6ff"
theme[used_mid]="#dfbbde"
theme[used_end]="#ffb4ab"
theme[download_start]="#3f4759"
theme[download_mid]="#bfc6dc"
theme[download_end]="#dbe2f9"
theme[upload_start]="#583e5a"
theme[upload_mid]="#dfbbde"
theme[upload_end]="#fcd7fb"
theme[process_start]="#bfc6dc"
theme[process_mid]="#aec6ff"
theme[process_end]="#ffb4ab"

# btop colors from the current wallpaper (matugen). Do not edit by hand,
# Template: ~/.config/matugen/templates/btop.theme
theme[main_bg]="#19120d"
theme[main_fg]="#f0dfd7"
theme[title]="#ffb787"
theme[hi_fg]="#ffb787"
theme[selected_bg]="#6e390e"
theme[selected_fg]="#ffdcc7"
theme[inactive_fg]="#9f8d83"
theme[graph_text]="#d7c3b8"
theme[meter_bg]="#312823"
theme[proc_misc]="#e5bfa8"
theme[cpu_box]="#ffb787"
theme[mem_box]="#e5bfa8"
theme[net_box]="#caca93"
theme[proc_box]="#ffb787"
theme[div_line]="#52443c"
# gradients: calm -> accent -> warning color at high load
theme[temp_start]="#e5bfa8"
theme[temp_mid]="#ffb787"
theme[temp_end]="#ffb4ab"
theme[cpu_start]="#e5bfa8"
theme[cpu_mid]="#ffb787"
theme[cpu_end]="#ffb4ab"
theme[free_start]="#5b4130"
theme[free_mid]="#e5bfa8"
theme[free_end]="#ffdcc7"
theme[cached_start]="#48491f"
theme[cached_mid]="#caca93"
theme[cached_end]="#e6e6ad"
theme[available_start]="#6e390e"
theme[available_mid]="#ffb787"
theme[available_end]="#ffdcc7"
theme[used_start]="#ffb787"
theme[used_mid]="#caca93"
theme[used_end]="#ffb4ab"
theme[download_start]="#5b4130"
theme[download_mid]="#e5bfa8"
theme[download_end]="#ffdcc7"
theme[upload_start]="#48491f"
theme[upload_mid]="#caca93"
theme[upload_end]="#e6e6ad"
theme[process_start]="#e5bfa8"

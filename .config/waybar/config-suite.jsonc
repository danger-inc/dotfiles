// New look (same content as classic, slightly taller). Switch: scripts/style-switch.sh
{
    "reload_config_on_change": false,
    "reload_style_on_change": true,
    "layer": "overlay",
    "position": "top",
    "height": 42,
    "margin-top": -42,
    "margin-left": 50,
    "margin-right": 50,
    "spacing": 10,
    "mod": "dock",
    "exclusive": false,
    "passthrough": false,
    "gtk-layer-shell": true,
    "modules-left": [
        "group/left"
    ],
    "modules-center": [
        "group/ws"
    ],
    "modules-right": [
        "tray",
        "group/connectivity",
        "cpu",
        "memory",
        "custom/separator",
        "custom/eco",
        "battery",
        "custom/notification",
        "custom/power"
    ],
    "clock": {
        // click: date instead of time; right click: datist; no hover calendar
        "format": "\uf017 {:%H:%M:%S %p}",
        "format-alt": "\udb80\udced {:%a, %d.%m.%Y}",
        "tooltip": false,
        "interval": 1,
        // right click: calendar (datist) on/off
        "cursor": false,   // a custom GTK3 hand cursor would go stale/crash after a color change; Hyprland draws it
        "on-click-right": "~/.local/bin/datist"
    },
    "custom/datist": {
        // next appointment from datist (datist --waybar); click opens the calendar
        "exec": "~/.local/bin/datist --waybar",
        "return-type": "json",
        "interval": 60,
        "signal": 8,   // datist refreshes it right away (pkill -RTMIN+8 waybar) when you hide / show an appointment
        "tooltip": true,
        "on-click": "~/.config/waybar/scripts/datist-menu.sh",   // left click: menu (like wifi/bluetooth)
        "on-click-right": "~/.local/bin/datist"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\udb81\udf5f",
        "format-icons": {
            "default": [
                "\uf026",
                "\uf027",
                "\uf028"
            ]
        },
        // left click: own mixer (total + per app), right click: own audio app (rice-audio),
        // middle click: mute, mouse wheel: louder/quieter
        "cursor": false,   // a custom GTK3 hand cursor would go stale/crash after a color change; Hyprland draws it
        "on-click": "~/.config/waybar/scripts/volume-mixer.sh",
        "on-click-right": "~/.local/bin/rice-audio",
        "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },
    "backlight": {
        // brightness like volume: mouse wheel = brighter/darker (same steps as the brightness keys)
        "device": "amdgpu_bl1",
        "format": "{icon} {percent}%",
        "format-icons": ["\udb80\udcde", "\udb80\udcdf", "\udb80\udce0"],
        "cursor": false,   // a custom GTK3 hand cursor would go stale/crash after a color change; Hyprland draws it
        "on-click": "~/.config/waybar/scripts/volume-mixer.sh bright",   // brightness card (like the volume mixer)
        "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
        "on-scroll-down": "brightnessctl -e4 -n2 set 5%-",
        "tooltip-format": "Helligkeit {percent}%",
        "smooth-scrolling-threshold": 1
    },
    "group/left": {
        // group, so the global "spacing" does not end up between clock, appointment, sound and brightness
        "orientation": "horizontal",
        "modules": ["clock", "custom/datist", "pulseaudio", "backlight"]
    },
    "group/ws": {
        // group, so the global "spacing" does not end up between the numbers
        "orientation": "horizontal",
        "modules": ["custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4"]
    },
    "custom/ws1": {
        // custom button instead of hyprland/workspaces (its click is broken with Lua Hyprland)
        "exec": "~/.config/waybar/scripts/workspace.py 1",
        "return-type": "json",
        "cursor": false,   // a custom GTK3 hand cursor would go stale/crash after a color change; Hyprland draws it
        "on-click": "~/.config/waybar/scripts/workspace.py 1 --go",
        "tooltip": false
    },
    "custom/ws2": {
        // custom button instead of hyprland/workspaces (its click is broken with Lua Hyprland)
        "exec": "~/.config/waybar/scripts/workspace.py 2",
        "return-type": "json",
        "cursor": false,   // a custom GTK3 hand cursor would go stale/crash after a color change; Hyprland draws it
        "on-click": "~/.config/waybar/scripts/workspace.py 2 --go",
        "tooltip": false
    },
    "custom/ws3": {
        // custom button instead of hyprland/workspaces (its click is broken with Lua Hyprland)
        "exec": "~/.config/waybar/scripts/workspace.py 3",
        "return-type": "json",
        "cursor": false,   // a custom GTK3 hand cursor would go stale/crash after a color change; Hyprland draws it
        "on-click": "~/.config/waybar/scripts/workspace.py 3 --go",
        "tooltip": false
    },
    "custom/ws4": {
        // custom button instead of hyprland/workspaces (its click is broken with Lua Hyprland)
        "exec": "~/.config/waybar/scripts/workspace.py 4",
        "return-type": "json",
        "cursor": false,   // a custom GTK3 hand cursor would go stale/crash after a color change; Hyprland draws it
        "on-click": "~/.config/waybar/scripts/workspace.py 4 --go",
        "tooltip": false
    },
    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "tooltip-format": "{controller_alias}: {status}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "cursor": false,   // a custom GTK3 hand cursor would go stale/crash after a color change; Hyprland draws it
        "on-click": "~/.config/waybar/scripts/bluetooth-menu.sh",
        "on-click-right": "~/.local/bin/rice-bluetooth"
    },
    "group/connectivity": {
        "orientation": "horizontal",
        "modules": [
            "network",
            "bluetooth"
        ]
    },
    "network": {
        "format-wifi": "󰖩",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "format-disabled": "󰖪",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "Not connected",
        "cursor": false,   // a custom GTK3 hand cursor would go stale/crash after a color change; Hyprland draws it
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
        "on-click-right": "~/.local/bin/rice-netz"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
    "cpu": {
        "interval": 1,
        "format": "\uf2db {usage}%",
        "cursor": false,   // a custom GTK3 hand cursor would go stale/crash after a color change; Hyprland draws it
        "on-click": "~/.config/waybar/scripts/btop-toggle.sh"
    },
    "memory": {
        "interval": 2,
        "format": "\uefc5  {used:0.1f}G/{total:0.1f}G",
        "cursor": false,   // a custom GTK3 hand cursor would go stale/crash after a color change; Hyprland draws it
        "on-click": "~/.config/waybar/scripts/btop-toggle.sh"
    },
    "custom/separator": {
        // click: switch the bar look (musicalist look ↔ classic)
        "format": "|",
        "tooltip-format": "Klick: Look wechseln (kopfzeile → reiter → klassisch)",
        "cursor": false,   // a custom GTK3 hand cursor would go stale/crash after a color change; Hyprland draws it
        "on-click": "setsid -f ~/.config/waybar/scripts/style-switch.sh"
    },
    "custom/eco": {
        // invisible: only the regular check for "switch the energy-saving mode on automatically" (battery menu)
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/eco.sh",
        "interval": 60,
        "signal": 9,
        "cursor": false,   // a custom GTK3 hand cursor would go stale/crash after a color change; Hyprland draws it
        "hide-empty-text": true
    },
    "battery": {
        "interval": 30,   // udev reports plugging/unplugging right away; capacity does not need 10 s
        "format": "{icon} {capacity}%",
        "format-charging": "\udb80\udc84 {capacity}%",
        "format-plugged": "\uf1e6 {capacity}%",
        "format-icons": [
            "\udb80\udc8e",
            "\udb80\udc7a",
            "\udb80\udc7b",
            "\udb80\udc7c",
            "\udb80\udc7d",
            "\udb80\udc7e",
            "\udb80\udc7f",
            "\udb80\udc80",
            "\udb80\udc81",
            "\udb80\udc82",
            "\udb80\udc79"
        ],
        "states": {
            "warning": 30,
            "critical": 15
        },
        // left click: menu with the energy-saving mode (battery-menu.sh), right click: remaining time
        "format-alt": "{icon} {time}",
        "format-time": "{H}:{m} h",
        "cursor": false,   // a custom GTK3 hand cursor would go stale/crash after a color change; Hyprland draws it
        "on-click": "~/.config/waybar/scripts/battery-menu.sh",
        "format-alt-click": "click-right",
        "tooltip": true
    },
    "custom/notification": {
        // script colors the dot with the matugen color (Pango has no CSS)
        "tooltip": false,
        "format": "{}",
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "~/.config/waybar/scripts/notification.py",
        "restart-interval": 1,
        "cursor": false,   // a custom GTK3 hand cursor would go stale/crash after a color change; Hyprland draws it
        "on-click": "~/.config/waybar/scripts/notification-click.sh",   // like the menus: closes other popups, opens directly
        "on-click-right": "swaync-client -d -sw",
        "escape": false
    },
    "custom/power": {
        "format": "\u23fb",
        "cursor": false,   // a custom GTK3 hand cursor would go stale/crash after a color change; Hyprland draws it
        "on-click": "~/.config/wlogout/launch.sh",
        "tooltip": false
    },
    "mpris": {
        "format": "{player_icon} {artist} - {title}",
        "format-paused": "{status_icon} <i>{artist} - {title}</i>",
        "max-length": 40,
        "player-icons": {
            "default": "\ud83c\udfb5",
            "musicalist": "\udb80\udf5a",
            "spotify": "\uf1bc",
            "zen": "\udb80\ude39",
            "firefox": "\uf269",
            "chromium": "\uf268",
            "vlc": "\udb81\udd7c"
        },
        "status-icons": {
            "paused": "\u23f8"
        },
        // click: pause/resume, right click: next track, middle click: previous
        "cursor": false,   // a custom GTK3 hand cursor would go stale/crash after a color change; Hyprland draws it
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous"
    }
}
